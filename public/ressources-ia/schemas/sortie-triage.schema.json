{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sortie de triage proposée par l'assistant",
  "type": "object",
  "additionalProperties": false,
  "required": ["classification", "gravite", "justification", "preuves", "action_proposee", "anomalies"],
  "properties": {
    "classification": {"enum": ["vrai_positif", "faux_positif", "indetermine"]},
    "gravite": {"enum": ["faible", "moyenne", "elevee", "critique"]},
    "justification": {"type": "string", "minLength": 10, "maxLength": 1200},
    "preuves": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E[0-9]{1,3}$"}},
    "action_proposee": {"enum": ["aucune", "ajouter_note", "escalader", "proposer_isolement"]},
    "anomalies": {"type": "array", "items": {"type": "string", "maxLength": 300}}
  }
}
